[Unit]
Description=plugNmeet recorder
Requires=network-online.target
After=network-online.target remote-fs.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
WorkingDirectory=/opt/plugNmeet/recorder
ExecStartPre=/bin/sh -c '/usr/bin/rm -rf /tmp/.X* /var/run/pulse /var/lib/pulse'
ExecStartPre=/usr/bin/pulseaudio -D --exit-idle-time=-1
ExecStart=/opt/plugNmeet/recorder/plugnmeet-recorder
ExecStopPost=/bin/sh -c '/usr/bin/rm -rf /tmp/.X* /var/run/pulse /var/lib/pulse'
TimeoutStartSec=30
Restart=always
RestartSec=10
SyslogIdentifier=plugNmeet-recorder

[Install]
WantedBy=multi-user.target
